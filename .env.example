PORT=8888
WECOM_CALLBACK_TOKEN=replace_with_your_callback_token
WECOM_ENCODING_AES_KEY=replace_with_your_43_character_encoding_aes_key

# Required to pull and send WeChat Customer Service messages.
WECOM_CORP_ID=ww0000000000000000
WECOM_KF_SECRET=replace_with_your_wechat_customer_service_secret

# Codex is denied for every customer until IDs are explicitly allowlisted.
# Use a comma-separated list such as wm_user_a,wm_user_b.
# Setting * allows every customer and is not recommended for a coding agent.
WECOM_ALLOWED_USER_IDS=

# Optional self-authorization. Disabled while the trigger is empty.
# An unauthorized customer must send the exact trigger as consecutive messages.
WECOM_AUTH_TRIGGER=
WECOM_AUTH_TRIGGER_COUNT=3
WECOM_AUTH_CONFIRMATION=暗号确认，请继续对话

# Optional runtime settings.
# WECOM_RECEIVE_ID defaults to WECOM_CORP_ID.
# WECOM_DB_FILE=./data/wecom.sqlite
# WECOM_STATE_FILE=./data/wecom-state.json # migration source only
# WECOM_LEGACY_JOURNAL_FILE=./data/wecom-tool-journal.sqlite
# WECOM_API_TIMEOUT_MS=10000
# SHUTDOWN_TIMEOUT_MS=10000

# Codex CLI app-server uses the existing local Codex login when CODEX_API_KEY is empty.
CODEX_ENABLED=true
CODEX_SANDBOX_MODE=read-only
CODEX_WEB_SEARCH_MODE=live
# CODEX_IMAGE_TMP_DIR=./data/codex-input
# CODEX_API_KEY=
# CODEX_BASE_URL=
# CODEX_PATH=codex
# CODEX_MODEL=gpt-5.6-luna
# CODEX_REASONING_EFFORT=none
# CODEX_WORKING_DIRECTORY=./codex-workspace
# CODEX_GENERATED_IMAGE_DIR=./codex-workspace/generated_images
